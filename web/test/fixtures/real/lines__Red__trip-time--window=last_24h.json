   "sql": [
    "select direction_id, time_band, n_trips, n_scheduled_trips, n_excluded_outage, n_implausible, n_disruption, round(case when coalesce(coverage_pct, 0) >= 50 and n_trips > 0 then median_ett_s end, 1) as median_ett_s, round(case when coalesce(coverage_pct, 0) >= 50 and n_trips > 0 then p90_ett_s end, 1) as p90_ett_s, round(case when coalesce(coverage_pct, 0) >= 50 and n_trips > 0 then median_scheduled_s end, 1) as median_scheduled_s, round(case when coalesce(coverage_pct, 0) >= 50 and n_trips > 0 then median_actual_s end, 1) as median_actual_s, round(coverage_pct, 1) as coverage_pct from read_parquet('<gold_snapshot>/gold/agg_ett_band_window.parquet') where line = 'Red' and window_label = 'last_24h' order by direction_id, case time_band when 'am_peak' then 0 when 'midday' then 1 when 'pm_peak' then 2 when 'evening' then 3 when 'other' then 4 else 9 end, time_band limit 501",
    "select n_trips, n_scheduled_trips, n_excluded_outage, n_implausible, n_disruption, round(case when coalesce(coverage_pct, 0) >= 50 and n_trips > 0 then median_ett_s end, 1) as median_ett_s, round(case when coalesce(coverage_pct, 0) >= 50 and n_trips > 0 then p90_ett_s end, 1) as p90_ett_s, round(coverage_pct, 1) as coverage_pct from read_parquet('<gold_snapshot>/gold/agg_ett_window.parquet') where line = 'Red' and window_label = 'last_24h'"
   ],
