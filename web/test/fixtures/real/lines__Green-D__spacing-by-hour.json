   "sql": [
    "with t as (select service_date, hour_local, (cast(service_date as timestamp) + to_hours(hour_local + case when hour_local < 3 then 24 else 0 end)) at time zone 'America/New_York' as hour_start, direction_id, n_headways, pct_within_band, pct_bunched, pct_gap, scheduled_headways, coverage_numerator, coverage_denominator, data_outage from read_parquet('/Users/akshay/projects/headway/tests/fixtures/gold_snapshot/gold/agg_headway_adherence_hourly.parquet') where line = 'Green-D' and service_date = (select max(service_date) from read_parquet('/Users/akshay/projects/headway/tests/fixtures/gold_snapshot/gold/agg_headway_adherence_hourly.parquet') where line = 'Green-D')), g as (select service_date, hour_local, any_value(hour_start) as hour_start, sum(n_headways) as n_headways, sum(pct_within_band * n_headways) filter (where n_headways > 0) / nullif(sum(n_headways) filter (where n_headways > 0), 0) as pct_within_band, sum(pct_bunched * n_headways) filter (where n_headways > 0) / nullif(sum(n_headways) filter (where n_headways > 0), 0) as pct_bunched, sum(pct_gap * n_headways) filter (where n_headways > 0) / nullif(sum(n_headways) filter (where n_headways > 0), 0) as pct_gap, sum(scheduled_headways) as scheduled_headways, 100.0 * sum(coverage_numerator) / nullif(sum(coverage_denominator), 0) as coverage_pct, bool_or(data_outage) as data_outage from t group by service_date, hour_local) select strftime(service_date, '%Y-%m-%d') as service_date, hour_local, strftime(hour_start at time zone 'UTC', '%Y-%m-%dT%H:%M:%SZ') as hour_start, n_headways, round(case when coalesce(coverage_pct, 0) >= 50 and not data_outage then pct_within_band end, 2) as pct_within_band, round(case when coalesce(coverage_pct, 0) >= 50 and not data_outage then pct_bunched end, 2) as pct_bunched, round(case when coalesce(coverage_pct, 0) >= 50 and not data_outage then pct_gap end, 2) as pct_gap, scheduled_headways, round(coverage_pct, 1) as coverage_pct, data_outage from g order by hour_start limit 501"
