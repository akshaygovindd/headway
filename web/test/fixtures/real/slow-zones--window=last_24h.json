  "provenance": {
   "definition": "Observed slow segments (a signal, not official) and the comparison with the MBTA's speed-restriction list (a hand-captured snapshot)",
   "metrics_md": "docs/METRICS.md#release-4-site-metrics",
   "row_limit": 500,
   "served_from": "remote",
   "sql": [
    "select s.line, s.direction_id, s.from_stop_id, n.from_stop_name, s.to_stop_id, n.to_stop_name, n.segment_order, s.time_band, s.n_trips, s.n_baseline_trips, s.n_disruption, round(case when coalesce(coverage_pct, 0) >= 50 then s.normal_s end, 1) as normal_s, round(case when coalesce(coverage_pct, 0) >= 50 then s.observed_s end, 1) as observed_s, round(case when coalesce(coverage_pct, 0) >= 50 then s.excess_s end, 1) as excess_s, round(case when coalesce(coverage_pct, 0) >= 50 then s.excess_pct end, 1) as excess_pct, round(case when coalesce(coverage_pct, 0) >= 50 then s.share_slow_pct end, 1) as share_slow_pct, case when coalesce(coverage_pct, 0) >= 50 then s.severity end as severity, case when coalesce(coverage_pct, 0) >= 50 then strftime(s.first_seen at time zone 'UTC', '%Y-%m-%dT%H:%M:%SZ') end as first_seen, case when coalesce(coverage_pct, 0) >= 50 then strftime(s.last_seen at time zone 'UTC', '%Y-%m-%dT%H:%M:%SZ') end as last_seen, round(s.coverage_pct, 1) as coverage_pct, not (coalesce(coverage_pct, 0) >= 50) as withheld from read_parquet('<gold_snapshot>/gold/agg_slow_segments.parquet') s left join (select line, direction_id, from_stop_id, to_stop_id, any_value(from_stop_name) as from_stop_name, any_value(to_stop_name) as to_stop_name, min(segment_order) as segment_order from read_parquet('<gold_snapshot>/gold/agg_headway_segment_window.parquet') where window_label = 'last_24h' group by all) n on n.line = s.line and n.direction_id = s.direction_id and n.from_stop_id = s.from_stop_id and n.to_stop_id = s.to_stop_id where s.flagged and s.window_label = 'last_24h' order by s.line, s.direction_id, n.segment_order, s.from_stop_id, case s.time_band when 'am_peak' then 0 when 'midday' then 1 when 'pm_peak' then 2 when 'evening' then 3 when 'other' then 4 else 9 end limit 501",
    "select status, observed_status, line, direction_id, from_stop_id, from_stop_name, to_stop_id, to_stop_name, segment_order, severity, round(worst_excess_s, 1) as worst_excess_s, n_trips, flagged_bands, strftime(first_seen at time zone 'UTC', '%Y-%m-%dT%H:%M:%SZ') as first_seen, strftime(last_seen at time zone 'UTC', '%Y-%m-%dT%H:%M:%SZ') as last_seen, restriction_ids, official_speed_limit_mph, strftime(official_date_reported, '%Y-%m-%d') as official_date_reported, location_text, official_status, strftime(snapshot_date, '%Y-%m-%d') as snapshot_date, source_url, is_snapshot from read_parquet('<gold_snapshot>/gold/agg_slow_zone_comparison.parquet') order by case status when 'matched' then 0 when 'observed_only' then 1 when 'listed_only' then 2 else 3 end, line, direction_id, segment_order, from_stop_id limit 501",
    "select any_value(official_status) as official_status, strftime(any_value(snapshot_date), '%Y-%m-%d') as snapshot_date, any_value(source_url) as source_url from read_parquet('<gold_snapshot>/gold/agg_slow_zone_comparison.parquet')"
   ],
   "tables": [
    "agg_slow_segments",
    "agg_headway_segment_window",
    "agg_slow_zone_comparison"
   ],
