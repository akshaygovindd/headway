{
  "name": "headway-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:mock": "node scripts/with-mock-api.mjs next build",
    "e2e:install": "playwright install chromium",
    "test:e2e": "playwright test",
    "ci": "npm run lint && npm run typecheck && npm run contracts:check && npm run fixtures:check && npm test && npm run build:mock && npm run e2e:install && npm run test:e2e",
    "contracts": "node scripts/build-contracts.mjs",
    "contracts:check": "node scripts/build-contracts.mjs --check",
    "fixtures": "uv run --project .. python ../scripts/build_web_fixtures.py",
    "fixtures:check": "uv run --project .. python ../scripts/build_web_fixtures.py --check"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.3.0",
    "axe-core": "^4.14.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "js-yaml": "^5.5.0",
    "jsdom": "31.0.1",
    "tailwindcss": "4.3.5",
    "typescript": "^5.9.3",
    "vitest": "5.1.1"
  },
  "type": "module"
}
